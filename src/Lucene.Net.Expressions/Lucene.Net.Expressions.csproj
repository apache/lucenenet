<Project Sdk="Microsoft.NET.Sdk">

  <!-- These properties must be set prior to importing nuget.props -->
  <PropertyGroup>
    <Description>Dynamically computed values to sort/facet/search on based on a pluggable grammar for the Lucene.NET full-text search engine library from The Apache Software Foundation.</Description>
    <PackageDocumentationRelativeUrl>expressions/overview.html</PackageDocumentationRelativeUrl>
  </PropertyGroup>

  <Import Project="$(SolutionDir).build/nuget.props" />

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>

    <AssemblyTitle>Lucene.Net.Expressions</AssemblyTitle>
    <PackageTags>$(PackageTags);expression</PackageTags>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lucene.Net.Queries\Lucene.Net.Queries.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-only: generates the expression parser from JS\JavascriptExpressionParser.parlot.cs into this assembly,
        so there is no runtime dependency on Parlot. -->
    <PackageReference Include="Parlot.SourceGenerator" Version="$(ParlotSourceGeneratorPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462' ">
    <!-- Required by the generated parser on downlevel targets -->
    <PackageReference Include="System.Memory" Version="$(SystemMemoryPackageVersion)" />
  </ItemGroup>

  <!-- The Parlot generator only accepts .NET Framework 4.7.2+ (PARLOT026), but the code it generates for
      .NET Standard 2.0 only needs System.Memory and System.ValueTuple, which net462 references. Report 4.7.2
      to the generator while the analyzer config is written, after references are resolved, and reference
      the netstandard facade that the generator compiles the grammar against. -->
  <Target Name="_LuceneRemoveParlotNetStandardReference" BeforeTargets="ResolveAssemblyReferences" Condition=" '$(TargetFramework)' == 'net462' ">
    <ItemGroup>
      <!-- Only .NET Framework 4.7.1+ reference assemblies have this facade -->
      <Reference Remove="netstandard" />
    </ItemGroup>
  </Target>

  <Target Name="_LuceneReferenceParlotNetStandardFacade" AfterTargets="ResolveAssemblyReferences" Condition=" '$(TargetFramework)' == 'net462' ">
    <ItemGroup>
      <ReferencePath Include="$(MSBuildExtensionsPath)/Microsoft/Microsoft.NET.Build.Extensions/net461/lib/netstandard.dll" />
    </ItemGroup>
  </Target>

  <Target Name="_LuceneReportParlotTargetFrameworkVersion" BeforeTargets="GenerateMSBuildEditorConfigFileCore" Condition=" '$(TargetFramework)' == 'net462' ">
    <PropertyGroup>
      <_LuceneTargetFrameworkVersion>$(TargetFrameworkVersion)</_LuceneTargetFrameworkVersion>
      <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    </PropertyGroup>
  </Target>

  <Target Name="_LuceneRestoreTargetFrameworkVersion" AfterTargets="GenerateMSBuildEditorConfigFileCore" Condition=" '$(TargetFramework)' == 'net462' ">
    <PropertyGroup>
      <TargetFrameworkVersion>$(_LuceneTargetFrameworkVersion)</TargetFrameworkVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Reflection.Emit" Version="$(SystemReflectionEmitPackageVersion)" />
    <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="$(SystemReflectionEmitILGenerationPackageVersion)" />
    <PackageReference Include="System.Reflection.TypeExtensions" Version="$(SystemReflectionTypeExtensionsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lucene.Net.Tests.Expressions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="JS\JavascriptCompiler.properties" />
  </ItemGroup>

</Project>
